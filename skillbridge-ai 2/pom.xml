<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.skillbridge</groupId>
    <artifactId>skillbridge-ai</artifactId>
    <version>1.0.0</version>
    <!-- Empaquetado WAR: pedido explícito para poder desplegar en un
         servidor de aplicaciones externo (Tomcat, etc.) además de poder
         seguir ejecutando el JAR embebido con "mvn spring-boot:run" en
         desarrollo (ver SkillbridgeAiApplication, que extiende
         SpringBootServletInitializer para soportar ambos casos). -->
    <packaging>war</packaging>
    <name>skillbridge-ai</name>
    <description>SkillBridge AI - plataforma interna de gestion de talento (NexaCorp)</description>

    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- Web MVC + Thymeleaf: sirve el frontend existente (templates/ + static/) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- Persistencia: JPA/Hibernate sobre el esquema MySQL ya provisto (skillbridge_db_v4.sql) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Validacion de formularios (Bean Validation) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Solo el modulo de criptografia de Spring Security: da BCryptPasswordEncoder
             para el hash de contrasenas sin activar el filtro de seguridad por defecto
             (la autenticacion/autorizacion de esta app se maneja a mano con sesion HTTP
             + SesionInterceptor, igual que el AuthFilter de referencia de QuintaOla-SGA,
             para no depender de una configuracion de Spring Security que no se puede
             verificar compilando en este entorno). -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- Empaquetado WAR: se necesita un contenedor Servlet embebido en tiempo
             de desarrollo (mvn spring-boot:run), pero NO dentro del WAR final,
             porque el servidor externo (Tomcat) ya provee el suyo. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-tomcat</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>skillbridge-ai</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
