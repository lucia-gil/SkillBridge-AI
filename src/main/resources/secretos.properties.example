# Copia este archivo como secretos.properties (misma carpeta) y completa
# los valores. secretos.properties esta en .gitignore: nunca se sube.
# Alternativa (recomendada en el EC2): variables de entorno
#   export DB_USERNAME='root'
#   export DB_PASSWORD='...'
#   export MAIL_PASSWORD='...'
DB_USERNAME=root
DB_PASSWORD=cambia_esto
MAIL_PASSWORD=contraseña_de_aplicacion_de_gmail
# Clave de la API de Claude (console.anthropic.com -> Claves y acceso).
ANTHROPIC_API_KEY=tu_clave_de_claude
# Opcional: proveedor de respaldo si Claude falla (clave gratis en
# https://console.groq.com/keys). Vacio = solo Claude.
IA_RESPALDO_API_KEY=
